{
    "manifest_version": 3,
    "name": "Internet Expedition",
    "version": "1.0",
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "permissions": [
        "activeTab",
        "scripting",
        "contextMenus",
        "storage"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "host_permissions": [
        "http://localhost/*",
        "https://*.youtube.com/*",
        "https://*.linkedin.com/*",
        "https://*.pinterest.com/*",
        "https://*.twitter.com/*",
        "https://*.x.com/*",
        "http://127.0.0.1:8080/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content/readability-core.js",
                "content/readability-utils.js",
                "content/readability-predicates.js",
                "content/readability-metadata.js",
                "content/readability-preprocess.js",
                "content/readability-postprocess.js",
                "content/readability-scoring.js",
                "content/readability-parse.js",
                "content/confirmation.js",
                "content/universal.js"
            ],
            "css": [
                "content/confirmation.css"
            ]
        },
        {
            "matches": [
                "https://*.x.com/*",
                "https://*.twitter.com/*"
            ],
            "js": [
                "content/twitter.js"
            ],
            "css": [
                "content/button.css"
            ]
        },
        {
            "matches": [
                "https://*.pinterest.com/*"
            ],
            "js": [
                "content/pinterest.js"
            ],
            "css": [
                "content/button.css"
            ]
        },
        {
            "matches": [
                "https://*.youtube.com/*"
            ],
            "js": [
                "content/youtube.js"
            ],
            "css": [
                "content/button.css"
            ]
        },
        {
            "matches": [
                "https://www.linkedin.com/*"
            ],
            "js": [
                "content/early.js"
            ],
            "run_at": "document_start"
        },
        {
            "matches": [
                "https://*.linkedin.com/*"
            ],
            "js": [
                "content/linkedin.js"
            ],
            "css": [
                "content/button.css"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "inject.js"
            ],
            "matches": [
                "https://www.linkedin.com/*"
            ]
        },
        {
            "resources": [
                "icons/*"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}